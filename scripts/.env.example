# Copie este arquivo para `.env` (NÃO versionado — já está no .gitignore)
# e preencha com os seus próprios valores. set-secrets.sh lê este arquivo e
# manda cada linha para `supabase secrets set`.
#
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY NÃO entram
# aqui: toda Edge Function já recebe essas três automaticamente do projeto
# onde está rodando — não precisam (e não devem) ser configuradas manualmente.

# ── Obrigatório para o primeiro admin existir (manage-usuarios) ─────────
# Qualquer string aleatória longa seu (ex.: `openssl rand -hex 32`). Usada
# uma única vez, por bootstrap-admin.sh, para criar a primeira conta admin
# antes de existir qualquer usuário no banco. Depois disso pode continuar
# configurada (não expira sozinha) ou ser removida do projeto.
APPVENDAS_BOOTSTRAP_SECRET=

# ── Obrigatório para o cron de lembretes existir (appvendas-lembretes) ──
# Protege o endpoint contra chamadas de qualquer um: o agendador precisa
# enviar ?secret=<este valor> na URL. Qualquer string aleatória sua.
APPVENDAS_LEMBRETES_SECRET=

# ── E-mail transacional (Resend) — opcional ──────────────────────────────
# Sem isso, envio de proposta por e-mail (enviar-proposta), lembrete de
# vencimento/aula (appvendas-lembretes) e confirmação de negócio
# (enviar-confirmacao-negocio) falham silenciosamente ao tentar enviar (o
# resto de cada função continua funcionando). Crie uma conta em
# https://resend.com, gere uma API key e verifique um domínio seu.
RESEND_API_KEY=
# Precisa ser um endereço do domínio que você verificou acima — o padrão
# onboarding@resend.dev só entrega pra caixa dona da conta Resend.
RESEND_FROM_ADDRESS=notificacoes@seudominio.com

# ── Pagamento via Stripe — opcional ──────────────────────────────────────
# Sem isso, a forma de pagamento "Stripe" (QR/link) em Vendas/Matrículas
# falha ao tentar abrir o checkout — Dinheiro/Pix/Cartão (manual) continuam
# funcionando normalmente sem nenhuma destas chaves.
STRIPE_SECRET_KEY=
# Gerado ao criar o endpoint do webhook no dashboard do Stripe (ver
# scripts/README.md) — precisa apontar para a Edge Function stripe-webhook
# já deployada.
STRIPE_WEBHOOK_SECRET=

# ── Lembretes por WhatsApp (Z-API) — opcional ────────────────────────────
# Sem isso, appvendas-lembretes continua mandando os lembretes por e-mail
# (se RESEND_API_KEY estiver configurado) — só o envio por WhatsApp falha.
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=
